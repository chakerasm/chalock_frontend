{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!dist-ssr",
      "!playwright-report",
      "!public/mockServiceWorker.js",
      "!storybook-static",
      "!test-results",
      "!src/routeTree.gen.ts",
      "!.cta.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
